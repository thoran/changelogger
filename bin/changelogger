#!/usr/bin/env ruby
# changelogger

# 20260906
# 0.18.0

# Description:
# Given a directory of numbered subdirectories (0, 1, 2, ...) each representing
# a version of a project, extract changelog information and write a cumulative
# CHANGELOG file into each version directory.
#
# The header read is bin/<anything> where there is one, that being what a program
# carries, and lib/<revisions root>.rb after it, that being where a library keeps
# its own.  After those, the two places older layouts kept it: <revisions
# root>.rbd/<revisions root>.rb, the retired self-contained layout, and the
# revision's root itself.  Where a place holds several .rb files and none is named
# for the root, the one named as the header was in the revision before is taken.
# --header-file names it outright, which is how a project holding both says which
# it means.
#
# Tiers:
# 1. If the header has Changes: comments, use them directly.
# 2. If not, diff the Ruby structure (name, methods, requires, classes) against
#    the previous version.
# 3. For the initial version, inventory what's present.
#
# If a CHANGELOG already exists in a version directory, that directory is skipped.

# Examples:
# 1. changelogger ~/path/to/revisions/root/
# 2. changelogger .
# 3. changelogger # . is implicit
# 4. changelogger -f lib/Browser.rb ~/path/to/revisions/root/

USAGE = "Usage: changelogger [-f|--header-file <path>] [<revisions_root>]"

# The file whose header holds the Changes section, named relative to each numbered
# directory.  Given, it settles which file is read; a project holding both bin/ and
# lib/ has no other way of saying.
def parse_arguments
  return if @arguments_parsed
  @arguments_parsed = true
  index = ARGV.index('-f') || ARGV.index('--header-file')
  return unless index
  path = ARGV[index + 1]
  unless path
    $stderr.puts USAGE
    exit 1
  end
  ARGV.slice!(index, 2)
  @header_file = path
end

def header_file
  parse_arguments
  @header_file
end

def revisions_root
  @revisions_root ||= (
    parse_arguments
    revisions_root = (
      if ARGV[0]
        unless File.exist?(ARGV[0])
          $stderr.puts USAGE
          exit 1
        end
        ARGV[0]
      else
        '.'
      end
    )
    File.expand_path(revisions_root)
  )
end

def version_directories
  @version_directories ||= (
    Dir["#{revisions_root}/*"]
      .select{|d| File.directory?(d) && File.basename(d) =~ /\A\d+\z/}
      .sort_by{|d| File.basename(d).to_i}
  )
end

# Files only: a directory whose name begins with changelog is not one.
def changelog_exist?(directory)
  (Dir["#{directory}/CHANGELOG*"] + Dir["#{directory}/changelog*"]).any?{|entry| File.file?(entry)}
end

# A name is the same regardless of case and with or without underscores:
# csv_file.rb became CSVFile.rb without becoming another library.
def same_name?(a, b)
  a.delete('_').casecmp?(b.delete('_'))
end

def revisions_root_name
  File.basename(revisions_root)
end

def predecessor(directory)
  index = version_directories.index(directory)
  index && index > 0 ? version_directories[index - 1] : nil
end

# The name the header file had in the revision before, a library keeping its name
# from one revision to the next far more often than it changes it.
def previous_header_name(directory)
  previous = predecessor(directory)
  return nil unless previous
  binary = find_binary(previous)
  binary && File.basename(binary, '.rb')
end

# Among the .rb files of one place: preferred is the file named for the revisions
# root; failing that the only one there, there being nothing to choose between two;
# failing that the one named as the header was in the revision before.
def choose(entries, directory)
  named = entries.detect{|entry| same_name?(File.basename(entry, '.rb'), revisions_root_name)}
  return named if named
  return entries.first if entries.length == 1
  previous_name = previous_header_name(directory)
  previous_name && entries.detect{|entry| same_name?(File.basename(entry, '.rb'), previous_name)}
end

# A library keeps its header in lib/, named for the project rather than sitting alone
# in bin/.
def find_library(directory)
  lib_dir = File.join(directory, 'lib')
  return nil unless Dir.exist?(lib_dir)
  choose(Dir["#{lib_dir}/*.rb"], directory)
end

# The retired self-contained layout: <name>.rbd/<name>.rb, with its own lib/ inside.
def find_self_contained(directory)
  choose(Dir["#{directory}/*.rbd/*.rb"], directory)
end

# The revision's root itself, which is where the earliest layouts kept the file.
def find_at_root(directory)
  choose(Dir["#{directory}/*.rb"], directory)
end

def find_bin(directory)
  bin_dir = File.join(directory, 'bin')
  return nil unless Dir.exist?(bin_dir)
  Dir["#{bin_dir}/*"].reject{|f| File.directory?(f)}.first
end

# Given a header file, that settles it.  Otherwise bin/ is looked to first, which is
# what a program carries, lib/ after it, and the two older places after that.  The
# answer is kept, a revision's header being asked for from several places and by the
# revision after it.
def find_binary(directory)
  @binaries ||= {}
  return @binaries[directory] if @binaries.key?(directory)
  @binaries[directory] = (
    if header_file
      path = File.join(directory, header_file)
      File.exist?(path) ? path : nil
    else
      find_bin(directory) || find_library(directory) || find_self_contained(directory) || find_at_root(directory)
    end
  )
end

def read_header_comments(filepath)
  return [] unless filepath && File.exist?(filepath)
  lines = File.readlines(filepath)
  comments = []
  lines.each do |line|
    break unless line =~ /\A#/ || line.strip.empty?
    comments << line
  end
  comments
end

def parse_name(comments)
  comments.each do |line|
    next if line =~ /\A# \d/
    return $1 if line =~ /\A# (\S+)\s*\z/
  end
  nil
end

# A dotted date, 2010.03.25, has the shape of a version and stands above it, so
# the date line is passed over.  A remark may follow the version in parentheses,
# `0.9.9 (in progress)`, as one may follow the date.
def parse_version(comments)
  comments.each do |line|
    next if line =~ DATE_LINE
    return $1 if line =~ /\A# (\d+\.\d+\.\d+)\s*(?:\(.*\))?\s*\z/
  end
  nil
end

# A date line may carry more than one date, the work having spanned days: only as
# much as changes is written, so an element escalates against the one before it —
# one or two digits being a day within the same month, four being MMDD within the
# same year, eight being a date outright.  The last is the completion date, which
# is the one a version takes.  A retired form, met when reading older headers.
def expand_dates(text)
  parts = text.split(/\s*,\s*/)
  dates = [parts.first]
  parts.drop(1).each do |part|
    previous = dates.last
    dates << (
      case part.length
      when 1, 2 then previous[0, 6] + part.rjust(2, '0')
      when 4 then previous[0, 4] + part
      when 8 then part
      else previous
      end
    )
  end
  dates.last
end

# A date may be written with dots, 2010.03.25, another retired form, and the dots
# are dropped before the elements are read.  A remark may follow in parentheses,
# which is where a correction to the date was noted.
DATE_LINE = /\A# (\d{4}\.?\d{2}\.?\d{2}(?:\s*,\s*[\d.]{1,10})*)\s*(?:\(.*\))?\s*\z/

def parse_date(comments)
  comments.each do |line|
    return expand_dates($1.delete('.')) if line =~ DATE_LINE
  end
  nil
end

def marker_summary(text)
  summary = text.strip.sub(/\A\((.*)\)\z/, '\1').strip
  summary.empty? ? nil : summary
end

# A marker tells one version's items from another's within a cumulative
# section.  A section covering a single version needs none, and some carry
# none, so the items begin an entry of their own.
def begin_entry(entries, label, summary)
  entry = {label: label, summary: summary, items: [], unparsed: []}
  entries << entry
  entry
end

# The line after the section's heading, or after a marker carrying no summary
# of its own, is that entry's summary where it is prose rather than an item.
# Prose does not begin with a digit, which keeps a malformed marker out, and an
# entry which already has items is past the place a summary belongs.
def summary_line?(entry, line)
  return false if entry && (entry[:summary] || !entry[:items].empty?)
  line !~ /\A#\s*\d/
end

# An item too long for its line is continued on the next, indented past where
# an item's number would be.  An enumerator begins something of its own rather
# than continuing what came before, which is what tells a wrapped line from a
# sub-item: the first is joined on, the second is left to be reported.
def continuation_line?(entry, line)
  return false unless entry && !entry[:items].empty?
  return false unless line =~ /\A#\s\s+\S/
  line !~ /\A#\s+(\d+|[ivx]+|[a-z])[.)]\s/
end

def parse_changes(comments)
  in_changes = false
  entries = []
  current_entry = nil
  @unparsed_lines = []
  comments.each do |line|
    line = line.chomp
    if line =~ /\A# Changes[\s:]/
      in_changes = true
      next
    end
    next unless in_changes
    if line =~ /\A# (\d+\/\d+|-\/0):?\s*(.*)\z/
      current_entry = begin_entry(entries, $1, marker_summary($2))
    elsif line =~ /\A# \d+\.\s+(.+)\z/
      current_entry ||= begin_entry(entries, nil, nil)
      current_entry[:items] << $1.strip
    elsif line =~ /\A#\s*\z/ || line.strip.empty?
      next
    elsif line =~ /\A# [A-Z][A-Za-z ]*:/
      break
    elsif line !~ /\A#/
      break
    elsif continuation_line?(current_entry, line)
      current_entry[:items][-1] += " #{line.sub(/\A#\s*/, '').strip}"
    elsif summary_line?(current_entry, line)
      current_entry ||= begin_entry(entries, nil, nil)
      current_entry[:summary] = line.sub(/\A#\s*/, '').strip
    else
      (current_entry ? current_entry[:unparsed] : @unparsed_lines) << line
    end
  end
  return nil if entries.empty?
  # Lines met before any entry began belong to the first of them, and are
  # surfaced when that entry is the one returned.
  entries.first[:unparsed] = @unparsed_lines + entries.first[:unparsed]
  entries.last
end

def empty_structure
  {name: nil, requires: [], methods: [], classes: [], modules: []}
end

def extract_structure(filepath)
  return empty_structure unless filepath && File.exist?(filepath)
  lines = File.readlines(filepath)
  {
    name: parse_name(read_header_comments(filepath)),
    requires: lines.grep(/\A\s*require\s/).map{|l| l.strip},
    methods: lines.grep(/\A\s*def\s/).map{|l| l.strip.sub(/\Adef\s+/, '').sub(/\(.*/, '').strip},
    classes: lines.grep(/\A\s*class\s/).map{|l| l.strip.sub(/\Aclass\s+/, '').sub(/\s*<.*/, '').strip},
    modules: lines.grep(/\A\s*module\s/).map{|l| l.strip.sub(/\Amodule\s+/, '').strip},
  }
end

def inventory_items(structure)
  items = []
  structure[:requires].each{|r| items << "+ #{r}"}
  structure[:modules].each{|m| items << "+ module #{m}"}
  structure[:classes].each{|c| items << "+ class #{c}"}
  structure[:methods].each{|m| items << "+ #{m}()"}
  items
end

def name_change(previous_structure, current_structure)
  previous_name = previous_structure[:name]
  current_name = current_structure[:name]
  return [] unless previous_name && current_name && previous_name != current_name
  ["/#{previous_name}/#{current_name}/"]
end

def structural_diff(previous_structure, current_structure)
  items = name_change(previous_structure, current_structure)
  removed_requires = previous_structure[:requires] - current_structure[:requires]
  added_requires = current_structure[:requires] - previous_structure[:requires]
  removed_modules = previous_structure[:modules] - current_structure[:modules]
  added_modules = current_structure[:modules] - previous_structure[:modules]
  removed_classes = previous_structure[:classes] - current_structure[:classes]
  added_classes = current_structure[:classes] - previous_structure[:classes]
  removed_methods = previous_structure[:methods] - current_structure[:methods]
  added_methods = current_structure[:methods] - previous_structure[:methods]
  removed_requires.each{|r| items << "- #{r}"}
  added_requires.each{|r| items << "+ #{r}"}
  removed_modules.each{|m| items << "- module #{m}"}
  added_modules.each{|m| items << "+ module #{m}"}
  removed_classes.each{|c| items << "- class #{c}"}
  added_classes.each{|c| items << "+ class #{c}"}
  removed_methods.each{|m| items << "- #{m}()"}
  added_methods.each{|m| items << "+ #{m}()"}
  common_methods = current_structure[:methods] & previous_structure[:methods]
  items += detect_modified_methods(common_methods)
  items
end

def detect_modified_methods(common_methods)
  return [] unless @previous_binary_lines && @current_binary_lines
  modified = []
  common_methods.each do |method_name|
    previous_body = extract_method_body(@previous_binary_lines, method_name)
    current_body = extract_method_body(@current_binary_lines, method_name)
    modified << "~ #{method_name}()" if previous_body != current_body
  end
  modified
end

# A keyword opens a block where it begins the expression, and not where it
# qualifies one which has already been written: `return nil if x` carries no end
# and neither does `depth = n if line =~ //`, both of which the word-boundary
# match counted.  Anything so counted ran the extraction past the method's own
# end and into the rest of the file — tap-audit's install_body is sixteen lines
# and was read as six hundred and eighty, to the last line of the program — so
# every method holding a modifier was reported as altered whenever anything
# below it changed.
BLOCK_OPENERS = /\A\s*(def|class|module|if|unless|case|while|until|for|begin)\b/

# do opens one where it ends the line, with or without its parameters.  A do
# elsewhere upon the line belongs to a one-line block, which closes itself.
BLOCK_DO = /\bdo\b\s*(\|[^|]*\|)?\s*\z/

def opens_block?(line)
  line =~ BLOCK_OPENERS || line =~ BLOCK_DO
end

def closes_block?(line)
  line.strip =~ /\Aend\b/
end

def extract_method_body(lines, method_name)
  in_method = false
  depth = 0
  body = []
  lines.each do |line|
    if !in_method && line =~ /\A\s*def\s+#{Regexp.escape(method_name)}\b/
      in_method = true
      depth = 1
      body << line
      next
    end
    if in_method
      depth += 1 if opens_block?(line)
      depth -= 1 if closes_block?(line)
      body << line
      break if depth <= 0
    end
  end
  body
end

def diff_binaries(previous_directory, current_directory)
  previous_binary = find_binary(previous_directory)
  current_binary = find_binary(current_directory)
  previous_structure = extract_structure(previous_binary)
  current_structure = extract_structure(current_binary)
  @previous_binary_lines = previous_binary ? File.readlines(previous_binary) : []
  @current_binary_lines = current_binary ? File.readlines(current_binary) : []
  items = structural_diff(previous_structure, current_structure)
  if items.empty? && binary_content_changed?(previous_binary, current_binary)
    items = diff_line_summary(previous_binary, current_binary)
  end
  items
end

def binary_content_changed?(previous_binary, current_binary)
  return false unless previous_binary && current_binary
  return false unless File.exist?(previous_binary) && File.exist?(current_binary)
  File.read(previous_binary) != File.read(current_binary)
end

def diff_line_summary(previous_file, current_file)
  previous_lines = File.readlines(previous_file).map(&:strip)
  current_lines = File.readlines(current_file).map(&:strip)
  added = (current_lines - previous_lines).length
  removed = (previous_lines - current_lines).length
  name = File.basename(current_file)
  parts = []
  parts << "+#{added} lines" if added > 0
  parts << "-#{removed} lines" if removed > 0
  return [] if parts.empty?
  ["~ #{name} (#{parts.join(', ')})"]
end

def diff_other_files(previous_directory, current_directory)
  previous_files = non_binary_files(previous_directory)
  current_files = non_binary_files(current_directory)
  added = current_files - previous_files
  removed = previous_files - current_files
  common = current_files & previous_files
  modified = common.select do |relative_path|
    File.read(File.join(previous_directory, relative_path)) !=
      File.read(File.join(current_directory, relative_path))
  end
  items = []
  removed.each{|f| items << "- #{f}"}
  added.each{|f| items << "+ #{f}"}
  modified.each{|f| items << "~ #{f}"}
  items
end

def non_binary_files(directory)
  bin_dir = File.join(directory, 'bin')
  Dir["#{directory}/**/*"]
    .reject{|f| File.directory?(f)}
    .reject{|f| f.start_with?("#{bin_dir}/")}
    .reject{|f| File.basename(f) =~ /\ACHANGELOG/i}
    .map{|f| f.sub("#{directory}/", '')}
end

MISSING_DATE = '????????'
UNPARSED_MARK = '?'

# Whatever the Changes section holds which is none of a marker, a numbered
# item or a blank line.  Dropping it silently is how a hand-written entry goes
# missing without anything saying so, and the whole of should2expect's did.
def unparsed_items(directory, lines)
  Array(lines).map do |line|
    $stderr.puts "#{File.basename(directory)}: not understood in the Changes section, wrote it as #{UNPARSED_MARK}: #{line}"
    "#{UNPARSED_MARK} #{line.sub(/\A#\s*/, '')}"
  end
end

def heading_date(date, directory)
  return date if date
  $stderr.puts "#{File.basename(directory)}: no date in the script header; wrote #{MISSING_DATE} in its place"
  MISSING_DATE
end

def summary_line(version, summary)
  [version, summary].compact.join(': ')
end

# The date is returned beside the body rather than written into it, the writer
# deciding when a heading is due.
def format_entry(version, date, directory, items, summary)
  if summary.nil? && items.length == 1
    summary = items.first
  end
  lines = []
  lines << summary_line(version, summary)
  unless items.empty?
    lines << ''
    items.each_with_index{|item, i| lines << "#{i + 1}. #{item}"}
  end
  {date: heading_date(date, directory), body: lines.join("\n")}
end

def initial_other_files(directory)
  non_binary_files(directory).map{|f| "+ #{f}"}
end

# A first revision is summarised by what it holds, the header file first and the
# rest after it, as a first commit written by hand says `+ .gitignore`.  Beyond
# three the rest are counted, a subject line being no place for a manifest.
def holdings_summary(binary, directory)
  files = []
  files << binary.sub("#{directory}/", '') if binary
  files += (non_binary_files(directory) - files).sort
  return nil if files.empty?
  named = files.first(3)
  rest = files.length - named.length
  summary = "+ #{named.join(', ')}"
  rest > 0 ? "#{summary} and #{rest} more" : summary
end

# One heading per date rather than one per version.  Nine versions released
# upon one day wrote "## 20260304" nine times, which asserts nine occasions
# where there was one; under the dawn rule a date is a day's work, and the
# versions beneath a heading are the steps it was released in.  Entries stay
# two blank lines apart whether or not a heading stands between them.
def write_changelog(directory, entries)
  previous_date = nil
  blocks = entries.reverse.collect do |entry|
    block = entry[:date] == previous_date ? entry[:body] : "## #{entry[:date]}\n\n#{entry[:body]}"
    previous_date = entry[:date]
    block
  end
  content = "# CHANGELOG\n\n" + blocks.join("\n\n\n") + "\n"
  File.write(File.join(directory, 'CHANGELOG'), content)
end

# An item names what changed within the file it was read from, as an entry
# written by hand does: `~ bin/tap-audit: + usage()` rather than a bare
# `+ usage()`.  Tier 1's items are not passed through here, being written by
# hand already; nor is a name change, which names the program rather than
# anything within it.
def within(binary, directory, items)
  return items unless binary
  path = binary.sub("#{directory}/", '')
  items.collect{|item| item.start_with?('/') ? item : "~ #{path}: #{item}"}
end

def process_initial_version(directory)
  binary = find_binary(directory)
  comments = read_header_comments(binary)
  version = parse_version(comments)
  date = parse_date(comments)
  changes = parse_changes(comments)
  unparsed = unparsed_items(directory, changes ? changes[:unparsed] : @unparsed_lines)
  if changes
    items = changes[:items]
    summary = changes[:summary]
  else
    structure = extract_structure(binary)
    items = within(binary, directory, inventory_items(structure))
    items += initial_other_files(directory)
    summary = holdings_summary(binary, directory)
  end
  format_entry(version, date, directory, items + unparsed, summary)
end

def changes_are_new?(changes, previous_directory)
  return true unless changes
  return true unless previous_directory
  previous_binary = find_binary(previous_directory)
  previous_comments = read_header_comments(previous_binary)
  previous_changes = parse_changes(previous_comments)
  return true unless previous_changes
  changes != previous_changes
end

def process_subsequent_version(directory, index, previous_directory)
  binary = find_binary(directory)
  comments = read_header_comments(binary)
  version = parse_version(comments)
  date = parse_date(comments)
  changes = parse_changes(comments)
  # Before changes_are_new?, which parses the previous version and would leave
  # @unparsed_lines holding its lines rather than this one's.
  unparsed = unparsed_items(directory, changes ? changes[:unparsed] : @unparsed_lines)
  if changes && changes_are_new?(changes, previous_directory)
    items = changes[:items]
    summary = changes[:summary]
  else
    items = within(binary, directory, diff_binaries(previous_directory, directory))
    items += diff_other_files(previous_directory, directory)
    summary = nil
  end
  format_entry(version, date, directory, items + unparsed, summary)
end

# The entries a CHANGELOG already holds, oldest last as write_changelog wants
# them.  A block carries a date heading only where its date differs from the one
# written after it, so the heading last seen stands until another is met.
def entries_from(directory)
  path = File.join(directory, 'CHANGELOG')
  return [] unless File.exist?(path)
  date = nil
  File.read(path).sub(/\A# CHANGELOG\n\n/, '').split("\n\n\n").collect do |block|
    if block =~ /\A## (\S+)\n\n(.*)\z/m
      date = $1
      {date: date, body: $2.rstrip}
    else
      {date: date, body: block.rstrip}
    end
  end.reverse
end

def main
  revisions_root
  cumulative_entries = []
  previous_directory = nil
  version_directories.each_with_index do |directory, index|
    if changelog_exist?(directory)
      $stderr.puts "Skipping #{File.basename(directory)}: CHANGELOG already exists"
      # What it holds, rather than nothing.  A skipped revision contributed no
      # entry to the accumulator, so every revision after one was short by an
      # entry apiece and the last was short by as many as had been skipped.
      # Read from the file rather than regenerated, a revision being skipped
      # precisely because what it says has been written by hand.
      cumulative_entries = entries_from(directory)
      previous_directory = directory
      next
    end
    if index == 0
      entry = process_initial_version(directory)
    else
      entry = process_subsequent_version(directory, index, previous_directory)
    end
    cumulative_entries << entry
    write_changelog(directory, cumulative_entries.dup)
    puts "Wrote CHANGELOG for version #{File.basename(directory)}"
    previous_directory = directory
  end
end

main
