#!/usr/bin/env ruby
# changelogger

# 20261031
# 0.24.0

# Description:
# Given a directory of numbered subdirectories (0, 1, 2, ...) each representing
# a version of a project, describe each revision in a revisions.yml in the
# revisions root, its number, day and commit message, which is what
# git-import-all commits them by, and write a cumulative CHANGELOG from it into
# each version directory.  It is done in two steps, as interleaver's are, so as
# what was found can be looked at and corrected first: plan reads the revisions
# and writes revisions.yml, and build writes the CHANGELOGs from it.  Once
# planned, revisions.yml is the record, corrected where it stands, and build
# writes the CHANGELOGs afresh from it each time.
#
# The header read is bin/<anything> where there is one, that being what a program
# carries, and lib/<revisions root>.rb after it, that being where a library keeps
# its own.  After those, the two places older layouts kept it: <revisions
# root>.rbd/<revisions root>.rb, the retired self-contained layout, and the
# revision's root itself.  Where a place holds several .rb files and none is named
# for the root, the one named as the header was in the revision before is taken.
# --header-file names it outright, which is how a project holding both says which
# it means.
#
# Tiers:
# 1. If the header has Changes: comments, use them directly.
# 2. If not, diff the Ruby structure (name, methods, requires, classes) against
#    the previous version.
# 3. For the initial version, inventory what's present.
# 4. For a snapshot, a working copy taken between versions rather than a version,
#    state no version and summarise it by the whole of its diff.  A snapshot is a
#    revision identical to the one before it, or one which comes after a version
#    and whose header states neither a new version nor a new Changes item.
#
# A revision which already holds a CHANGELOG, written by hand, gives plan its
# entries from that rather than from its header, whether in changelogger's own
# form or with a version in each heading, and build then writes it afresh in
# changelogger's.  plan does not replace an existing revisions.yml, and build
# writes nothing from one which git-import-all would refuse.
#
# Where a header states no date, or one which is no date at all, such as 20060631,
# the header file's modification time is taken in its place, and a warning saying
# so goes to stderr.  Where there is none to take, plan writes ????-??-?? as the
# revision's time, to be given in revisions.yml.

# Examples:
# 1. changelogger plan ~/path/to/revisions/root/ # revisions.yml, beside 0, 1, 2, ...
# 2. changelogger build ~/path/to/revisions/root/ # a CHANGELOG into each of 0, 1, 2, ..., from revisions.yml
# 3. changelogger plan . && changelogger build # the revisions root defaults to .
# 4. changelogger plan -f lib/Browser.rb ~/path/to/revisions/root/
# 5. changelogger build -n ~/path/to/revisions/root/ # what would be written, writing nothing

require 'date'
require 'yaml'

USAGE = <<~USAGE
  Usage: changelogger plan [-f|--header-file <path>] [<revisions_root>]
         changelogger build [-n|--dry-run] [<revisions_root>]
USAGE

COMMANDS = %w[plan build]

def command
  @command ||= ARGV.shift
end

def usage_error
  $stderr.puts USAGE
  exit 1
end

def validate_command
  if %w[-h --help].include?(ARGV.first)
    puts USAGE
    exit
  end
  usage_error unless COMMANDS.include?(command)
end

# plan's header file is the file whose header holds the Changes section, named
# relative to each numbered directory.  Given, it settles which file is read; a
# project holding both bin/ and lib/ has no other way of saying.  build's dry run
# says what would be written and writes nothing.
def parse_arguments
  return if @arguments_parsed
  @arguments_parsed = true
  @header_file = take_option('-f', '--header-file') if command == 'plan'
  @dry_run = %w[-n --dry-run].any?{|flag| ARGV.delete(flag)} if command == 'build'
  usage_error if ARGV.any?{|argument| argument.start_with?('-')}
end

def take_option(*names)
  index = names.map{|name| ARGV.index(name)}.compact.first
  return nil unless index
  value = ARGV[index + 1]
  usage_error unless value
  ARGV.slice!(index, 2)
  value
end

def header_file
  parse_arguments
  @header_file
end

def dry_run?
  parse_arguments
  @dry_run
end

def revisions_root
  @revisions_root ||= (
    parse_arguments
    usage_error if ARGV[0] && !File.exist?(ARGV[0])
    File.expand_path(ARGV[0] || '.')
  )
end

def version_directories
  @version_directories ||= (
    Dir["#{revisions_root}/*"]
      .select{|d| File.directory?(d) && File.basename(d) =~ /\A\d+\z/}
      .sort_by{|d| File.basename(d).to_i}
  )
end

# Files only: a directory whose name begins with changelog is not one.
def changelog_path(directory)
  (Dir["#{directory}/CHANGELOG*"] + Dir["#{directory}/changelog*"]).detect{|entry| File.file?(entry)}
end

def changelog_exist?(directory)
  !changelog_path(directory).nil?
end

# A name is the same regardless of case and with or without underscores:
# csv_file.rb became CSVFile.rb without becoming another library.
def same_name?(a, b)
  a.delete('_').casecmp?(b.delete('_'))
end

def revisions_root_name
  File.basename(revisions_root)
end

def predecessor(directory)
  index = version_directories.index(directory)
  index && index > 0 ? version_directories[index - 1] : nil
end

# The name the header file had in the revision before, a library keeping its name
# from one revision to the next far more often than it changes it.
def previous_header_name(directory)
  previous = predecessor(directory)
  return nil unless previous
  binary = find_binary(previous)
  binary && File.basename(binary, '.rb')
end

# Among the .rb files of one place: preferred is the file named for the revisions
# root; failing that the only one there, there being nothing to choose between two;
# failing that the one named as the header was in the revision before.
def choose(entries, directory)
  named = entries.detect{|entry| same_name?(File.basename(entry, '.rb'), revisions_root_name)}
  return named if named
  return entries.first if entries.length == 1
  previous_name = previous_header_name(directory)
  previous_name && entries.detect{|entry| same_name?(File.basename(entry, '.rb'), previous_name)}
end

# A library keeps its header in lib/, named for the project rather than sitting alone
# in bin/.
def find_library(directory)
  lib_dir = File.join(directory, 'lib')
  return nil unless Dir.exist?(lib_dir)
  choose(Dir["#{lib_dir}/*.rb"], directory)
end

# The retired self-contained layout: <name>.rbd/<name>.rb, with its own lib/ inside.
def find_self_contained(directory)
  choose(Dir["#{directory}/*.rbd/*.rb"], directory)
end

# The revision's root itself, which is where the earliest layouts kept the file.
def find_at_root(directory)
  choose(Dir["#{directory}/*.rb"], directory)
end

def find_bin(directory)
  bin_dir = File.join(directory, 'bin')
  return nil unless Dir.exist?(bin_dir)
  Dir["#{bin_dir}/*"].reject{|f| File.directory?(f)}.first
end

# Given a header file, that settles it.  Otherwise bin/ is looked to first, which is
# what a program carries, lib/ after it, and the two older places after that.  The
# answer is kept, a revision's header being asked for from several places and by the
# revision after it.
def find_binary(directory)
  @binaries ||= {}
  return @binaries[directory] if @binaries.key?(directory)
  @binaries[directory] = (
    if header_file
      path = File.join(directory, header_file)
      File.exist?(path) ? path : nil
    else
      find_bin(directory) || find_library(directory) || find_self_contained(directory) || find_at_root(directory)
    end
  )
end

def read_header_comments(filepath)
  return [] unless filepath && File.exist?(filepath)
  lines = File.readlines(filepath)
  comments = []
  lines.each do |line|
    break unless line =~ /\A#/ || line.strip.empty?
    comments << line
  end
  comments
end

# The name is the first comment line holding a single word.  A header without one
# would give up a section's heading instead, `# Changes:`, so a word ending in a
# colon is passed over, being a heading rather than a name.
def parse_name(comments)
  comments.each do |line|
    next if line =~ /\A# \d/
    next if line =~ /:\s*\z/
    return $1 if line =~ /\A# (\S+)\s*\z/
  end
  nil
end

# A dotted date, 2010.03.25, has the shape of a version and stands above it, so
# the date line is passed over.  A remark may follow the version in parentheses,
# `0.9.9 (in progress)`, as one may follow the date.  A version may have more than
# three parts, `0.6.0.0`, as one or two of the older headers do.
def parse_version(comments)
  comments.each do |line|
    next if line =~ DATE_LINE
    return $1 if line =~ /\A# (\d+(?:\.\d+){2,})\s*(?:\(.*\))?\s*\z/
  end
  nil
end

# A date line may carry more than one date, the work having spanned days: only as
# much as changes is written, so an element escalates against the one before it —
# one or two digits being a day within the same month, four being MMDD within the
# same year, eight being a date outright.  The last is the completion date, which
# is the one a version takes.  A retired form, met when reading older headers.
def expand_dates(text)
  parts = text.split(/\s*,\s*/)
  dates = [parts.first]
  parts.drop(1).each do |part|
    previous = dates.last
    dates << (
      case part.length
      when 1, 2 then previous[0, 6] + part.rjust(2, '0')
      when 4 then previous[0, 4] + part
      when 8 then part
      else previous
      end
    )
  end
  dates.last
end

# A date may be written with dots, 2010.03.25, another retired form, and the dots
# are dropped before the elements are read.  A remark may follow in parentheses,
# which is where a correction to the date was noted.  And it may be labelled,
# `# Date: 20051014`, the oldest form, written before the date stood alone.
DATE_LINE = /\A# (?:Date:\s*)?(\d{4}\.?\d{2}\.?\d{2}(?:\s*,\s*[\d.]{1,10})*)\s*(?:\(.*\))?\s*\z/

def parse_date(comments)
  comments.each do |line|
    return expand_dates($1.delete('.')) if line =~ DATE_LINE
  end
  nil
end

def marker_summary(text)
  summary = text.strip.sub(/\A\((.*)\)\z/, '\1').strip
  summary.empty? ? nil : summary
end

# A marker tells one version's items from another's within a cumulative
# section.  A section covering a single version needs none, and some carry
# none, so the items begin an entry of their own.
def begin_entry(entries, label, summary)
  entry = {label: label, summary: summary, items: [], unparsed: []}
  entries << entry
  entry
end

# The line after the section's heading, or after a marker carrying no summary
# of its own, is that entry's summary where it is prose rather than an item.
# Prose does not begin with a digit, which keeps a malformed marker out, and an
# entry which already has items is past the place a summary belongs.
def summary_line?(entry, line)
  return false if entry && (entry[:summary] || !entry[:items].empty?)
  line !~ /\A#\s*\d/
end

# An item too long for its line is continued on the next, indented past where
# an item's number would be.  An enumerator begins something of its own rather
# than continuing what came before, which is what tells a wrapped line from a
# sub-item: the first is joined on, the second is left to be reported.
def continuation_line?(entry, line)
  return false unless entry && !entry[:items].empty?
  return false unless line =~ /\A#\s\s+\S/
  line !~ /\A#\s+(\d+|[ivx]+|[a-z])[.)]\s/
end

# A section's heading ends the Changes section above it, `# Todo:` or `# Ad-hoc
# ideas:`, a hyphenated word being as much a heading's as any other.
SECTION_HEADING = /\A# [A-Z][A-Za-z -]*:/

def parse_changes(comments)
  in_changes = false
  entries = []
  current_entry = nil
  @unparsed_lines = []
  comments.each do |line|
    line = line.chomp
    if line =~ /\A# Changes[\s:]/
      in_changes = true
      next
    end
    next unless in_changes
    if line =~ /\A# (\d+\/\d+|-\/0):?\s*(.*)\z/
      current_entry = begin_entry(entries, $1, marker_summary($2))
    elsif line =~ /\A# \d+\.\s+(.+)\z/
      current_entry ||= begin_entry(entries, nil, nil)
      current_entry[:items] << $1.strip
    elsif line =~ /\A#\s*\z/ || line.strip.empty?
      next
    elsif line =~ SECTION_HEADING
      break
    elsif line !~ /\A#/
      break
    elsif continuation_line?(current_entry, line)
      current_entry[:items][-1] += " #{line.sub(/\A#\s*/, '').strip}"
    elsif summary_line?(current_entry, line)
      current_entry ||= begin_entry(entries, nil, nil)
      current_entry[:summary] = line.sub(/\A#\s*/, '').strip
    else
      (current_entry ? current_entry[:unparsed] : @unparsed_lines) << line
    end
  end
  return nil if entries.empty?
  # Lines met before any entry began belong to the first of them, and are
  # surfaced when that entry is the one returned.
  entries.first[:unparsed] = @unparsed_lines + entries.first[:unparsed]
  entries.last
end

def empty_structure
  {name: nil, requires: [], methods: [], classes: [], modules: []}
end

def extract_structure(filepath)
  return empty_structure unless filepath && File.exist?(filepath)
  lines = File.readlines(filepath)
  {
    name: parse_name(read_header_comments(filepath)),
    requires: lines.grep(/\A\s*require\s/).map{|l| l.strip},
    methods: lines.grep(/\A\s*def\s/).map{|l| l.strip.sub(/\Adef\s+/, '').sub(/\(.*/, '').strip},
    classes: lines.grep(/\A\s*class\s/).map{|l| l.strip.sub(/\Aclass\s+/, '').sub(/\s*<.*/, '').strip},
    modules: lines.grep(/\A\s*module\s/).map{|l| l.strip.sub(/\Amodule\s+/, '').strip},
  }
end

def inventory_items(structure)
  items = []
  structure[:requires].each{|r| items << "+ #{r}"}
  structure[:modules].each{|m| items << "+ module #{m}"}
  structure[:classes].each{|c| items << "+ class #{c}"}
  structure[:methods].each{|m| items << "+ #{m}()"}
  items
end

def name_change(previous_structure, current_structure)
  previous_name = previous_structure[:name]
  current_name = current_structure[:name]
  return [] unless previous_name && current_name && previous_name != current_name
  ["/#{previous_name}/#{current_name}/"]
end

def structural_diff(previous_structure, current_structure)
  items = name_change(previous_structure, current_structure)
  removed_requires = previous_structure[:requires] - current_structure[:requires]
  added_requires = current_structure[:requires] - previous_structure[:requires]
  removed_modules = previous_structure[:modules] - current_structure[:modules]
  added_modules = current_structure[:modules] - previous_structure[:modules]
  removed_classes = previous_structure[:classes] - current_structure[:classes]
  added_classes = current_structure[:classes] - previous_structure[:classes]
  removed_methods = previous_structure[:methods] - current_structure[:methods]
  added_methods = current_structure[:methods] - previous_structure[:methods]
  removed_requires.each{|r| items << "- #{r}"}
  added_requires.each{|r| items << "+ #{r}"}
  removed_modules.each{|m| items << "- module #{m}"}
  added_modules.each{|m| items << "+ module #{m}"}
  removed_classes.each{|c| items << "- class #{c}"}
  added_classes.each{|c| items << "+ class #{c}"}
  removed_methods.each{|m| items << "- #{m}()"}
  added_methods.each{|m| items << "+ #{m}()"}
  common_methods = current_structure[:methods] & previous_structure[:methods]
  items += detect_modified_methods(common_methods)
  items
end

def detect_modified_methods(common_methods)
  return [] unless @previous_binary_lines && @current_binary_lines
  modified = []
  common_methods.each do |method_name|
    previous_body = extract_method_body(@previous_binary_lines, method_name)
    current_body = extract_method_body(@current_binary_lines, method_name)
    modified << "~ #{method_name}()" if previous_body != current_body
  end
  modified
end

# A keyword opens a block where it begins the expression, and not where it
# qualifies one which has already been written: `return nil if x` carries no end
# and neither does `depth = n if line =~ //`, both of which the word-boundary
# match counted.  Anything so counted ran the extraction past the method's own
# end and into the rest of the file — tap-audit's install_body is sixteen lines
# and was read as six hundred and eighty, to the last line of the program — so
# every method holding a modifier was reported as altered whenever anything
# below it changed.
BLOCK_OPENERS = /\A\s*(def|class|module|if|unless|case|while|until|for|begin)\b/

# do opens one where it ends the line, with or without its parameters.  A do
# elsewhere upon the line belongs to a one-line block, which closes itself.
BLOCK_DO = /\bdo\b\s*(\|[^|]*\|)?\s*\z/

def opens_block?(line)
  line =~ BLOCK_OPENERS || line =~ BLOCK_DO
end

def closes_block?(line)
  line.strip =~ /\Aend\b/
end

def extract_method_body(lines, method_name)
  in_method = false
  depth = 0
  body = []
  lines.each do |line|
    if !in_method && line =~ /\A\s*def\s+#{Regexp.escape(method_name)}\b/
      in_method = true
      depth = 1
      body << line
      next
    end
    if in_method
      depth += 1 if opens_block?(line)
      depth -= 1 if closes_block?(line)
      body << line
      break if depth <= 0
    end
  end
  body
end

def diff_binaries(previous_directory, current_directory)
  previous_binary = find_binary(previous_directory)
  current_binary = find_binary(current_directory)
  previous_structure = extract_structure(previous_binary)
  current_structure = extract_structure(current_binary)
  @previous_binary_lines = previous_binary ? File.readlines(previous_binary) : []
  @current_binary_lines = current_binary ? File.readlines(current_binary) : []
  items = structural_diff(previous_structure, current_structure)
  if items.empty? && binary_content_changed?(previous_binary, current_binary)
    items = diff_line_summary(previous_binary, current_binary)
  end
  items
end

def binary_content_changed?(previous_binary, current_binary)
  return false unless previous_binary && current_binary
  return false unless File.exist?(previous_binary) && File.exist?(current_binary)
  File.read(previous_binary) != File.read(current_binary)
end

def diff_line_summary(previous_file, current_file)
  previous_lines = File.readlines(previous_file).map(&:strip)
  current_lines = File.readlines(current_file).map(&:strip)
  added = (current_lines - previous_lines).length
  removed = (previous_lines - current_lines).length
  name = File.basename(current_file)
  parts = []
  parts << "+#{added} lines" if added > 0
  parts << "-#{removed} lines" if removed > 0
  return [] if parts.empty?
  ["~ #{name} (#{parts.join(', ')})"]
end

def diff_other_files(previous_directory, current_directory)
  previous_files = non_binary_files(previous_directory)
  current_files = non_binary_files(current_directory)
  added = current_files - previous_files
  removed = previous_files - current_files
  common = current_files & previous_files
  modified = common.select do |relative_path|
    File.read(File.join(previous_directory, relative_path)) !=
      File.read(File.join(current_directory, relative_path))
  end
  items = []
  removed.each{|f| items << "- #{f}"}
  added.each{|f| items << "+ #{f}"}
  modified.each{|f| items << "~ #{f}"}
  items
end

def non_binary_files(directory)
  bin_dir = File.join(directory, 'bin')
  Dir["#{directory}/**/*"]
    .reject{|f| File.directory?(f)}
    .reject{|f| f.start_with?("#{bin_dir}/")}
    .reject{|f| File.basename(f) =~ /\ACHANGELOG/i}
    .map{|f| f.sub("#{directory}/", '')}
end

MISSING_DATE = '????????'
UNPARSED_MARK = '?'

# Whatever the Changes section holds which is none of a marker, a numbered
# item or a blank line.  Dropping it silently is how a hand-written entry goes
# missing without anything saying so, and the whole of should2expect's did.
def unparsed_items(directory, lines)
  Array(lines).map do |line|
    $stderr.puts "#{File.basename(directory)}: not understood in the Changes section, wrote it as #{UNPARSED_MARK}: #{line}"
    "#{UNPARSED_MARK} #{line.sub(/\A#\s*/, '')}"
  end
end

# When the revision was last worked upon, which is the header file's modification
# time, and failing a header file the newest file in the revision's.  The file is
# returned beside the date so that the warning can name it.
def modification_date(directory)
  binary = find_binary(directory)
  files = binary ? [binary] : revision_files(directory).map{|f| File.join(directory, f)}
  return nil if files.empty?
  newest = files.max_by{|f| File.mtime(f)}
  [File.mtime(newest).strftime('%Y%m%d'), newest.sub("#{directory}/", '')]
end

# A modification time is said to have been taken each time it is, a copy which did
# not keep it dating every revision as the day of the copy.  Only a revision holding
# nothing has no date at all.
# A date as written may be no date at all, 20060631 being June's thirty-first, and
# such a one is said and set aside, the modification time being nearer the truth
# than a day which never was.
def real_date?(date)
  Date.valid_date?(date[0, 4].to_i, date[4, 2].to_i, date[6, 2].to_i)
end

def heading_date(date, directory)
  return date if date && real_date?(date)
  reason = date ? "#{date} in the script header is not a date" : "no date in the script header"
  date, file = modification_date(directory)
  if date
    $stderr.puts "#{File.basename(directory)}: #{reason}; took #{date} from the modification time of #{file}"
    return date
  end
  $stderr.puts "#{File.basename(directory)}: #{reason} and no file to take one from"
  MISSING_DATE
end

def summary_line(version, summary)
  [version, summary].compact.join(': ')
end

# The date is returned beside the body rather than written into it, the writer
# deciding when a heading is due.
def format_entry(version, date, directory, items, summary)
  if summary.nil? && items.length == 1
    summary = items.first
  end
  lines = []
  lines << summary_line(version, summary)
  unless items.empty?
    lines << ''
    items.each_with_index{|item, i| lines << "#{i + 1}. #{item}"}
  end
  {date: heading_date(date, directory), body: lines.join("\n")}
end

def initial_other_files(directory)
  non_binary_files(directory).map{|f| "+ #{f}"}
end

# A first revision is summarised by what it holds, the header file first and the
# rest after it, as a first commit written by hand says `+ .gitignore`.  Beyond
# three the rest are counted, a subject line being no place for a manifest.
def holdings_summary(binary, directory)
  files = []
  files << binary.sub("#{directory}/", '') if binary
  files += (non_binary_files(directory) - files).sort
  return nil if files.empty?
  named = files.first(3)
  rest = files.length - named.length
  summary = "+ #{named.join(', ')}"
  rest > 0 ? "#{summary} and #{rest} more" : summary
end

# One heading per date rather than one per version.  Nine versions released
# upon one day wrote "## 20260304" nine times, which asserts nine occasions
# where there was one; under the dawn rule a date is a day's work, and the
# versions beneath a heading are the steps it was released in.  Entries stay
# two blank lines apart whether or not a heading stands between them.
def changelog_content(entries)
  previous_date = nil
  blocks = entries.reverse.collect do |entry|
    block = entry[:date] == previous_date ? entry[:body] : "## #{entry[:date]}\n\n#{entry[:body]}"
    previous_date = entry[:date]
    block
  end
  "# CHANGELOG\n\n" + blocks.join("\n\n\n") + "\n"
end

def changelog_report(directory, existed)
  name = File.basename(directory)
  if dry_run?
    "Would #{existed ? 'rewrite' : 'write'} the CHANGELOG for version #{name}"
  else
    "#{existed ? 'Rewrote' : 'Wrote'} CHANGELOG for version #{name}"
  end
end

# Into the CHANGELOG a revision already holds, under whatever name it has, and
# only where what it holds is not what would be written.
def write_changelog(directory, entries)
  path = changelog_path(directory) || File.join(directory, 'CHANGELOG')
  content = changelog_content(entries)
  existed = File.exist?(path)
  return if existed && File.read(path) == content
  File.write(path, content) unless dry_run?
  puts changelog_report(directory, existed)
end

# An item names what changed within the file it was read from, as an entry
# written by hand does: `~ bin/tap-audit: + usage()` rather than a bare
# `+ usage()`.  Tier 1's items are not passed through here, being written by
# hand already; nor is a name change, which names the program rather than
# anything within it.
def within(binary, directory, items)
  return items unless binary
  path = binary.sub("#{directory}/", '')
  items.collect{|item| item.start_with?('/') ? item : "~ #{path}: #{item}"}
end

def process_initial_version(directory)
  binary = find_binary(directory)
  comments = read_header_comments(binary)
  version = parse_version(comments)
  date = parse_date(comments)
  changes = parse_changes(comments)
  unparsed = unparsed_items(directory, changes ? changes[:unparsed] : @unparsed_lines)
  if changes
    items = changes[:items]
    summary = changes[:summary]
  else
    structure = extract_structure(binary)
    items = within(binary, directory, inventory_items(structure))
    items += initial_other_files(directory)
    summary = holdings_summary(binary, directory)
  end
  format_entry(version, date, directory, items + unparsed, summary)
end

def changes_are_new?(changes, previous_directory)
  return true unless changes
  return true unless previous_directory
  previous_binary = find_binary(previous_directory)
  previous_comments = read_header_comments(previous_binary)
  previous_changes = parse_changes(previous_comments)
  return true unless previous_changes
  changes != previous_changes
end

def version_of(directory)
  @versions ||= {}
  return @versions[directory] if @versions.key?(directory)
  @versions[directory] = parse_version(read_header_comments(find_binary(directory)))
end

# The version last stated before this revision, by whichever revision stated it.
def version_before(directory)
  version_directories.take_while{|d| d != directory}.reverse.lazy.map{|d| version_of(d)}.detect{|version| version}
end

# Every file but the CHANGELOG, which is what changelogger writes rather than reads.
# The CHANGELOG itself and not whatever begins so: changelogger.rb is a file.
def revision_files(directory)
  Dir["#{directory}/**/*"]
    .reject{|f| File.directory?(f)}
    .reject{|f| File.basename(f) =~ /\ACHANGELOG(\.\w+)?\z/i}
    .map{|f| f.sub("#{directory}/", '')}
    .sort
end

def identical?(previous_directory, directory)
  files = revision_files(directory)
  files == revision_files(previous_directory) &&
    files.all?{|f| File.read(File.join(previous_directory, f)) == File.read(File.join(directory, f))}
end

# Before any version has been stated there is nothing for a revision to be between,
# and a history kept without versions is diffed as it always was.  A revision
# identical to the one before it is a snapshot whatever came before, there being
# nothing else it could be.
def snapshot?(directory, previous_directory, version, changes)
  return true if identical?(previous_directory, directory)
  previous_version = version_before(directory)
  return false unless previous_version
  return false if version && version != previous_version
  !(changes && changes_are_new?(changes, previous_directory))
end

# A file gone and one come, alone of their kind in one directory, are taken for one
# renamed: a fixture regenerated under the next name, test/6.0.csv --> test/6.1.csv.
# They are paired by name rather than by content, a regenerated fixture sharing no
# line with the one it replaced.
def renames(removed, added)
  kind = ->(f){[File.dirname(f), File.extname(f)]}
  removed.group_by(&kind).filter_map do |key, gone|
    come = added.select{|f| kind.(f) == key}
    [gone.first, come.first] if gone.length == 1 && come.length == 1
  end
end

def file_changes(previous_directory, directory)
  previous_files = revision_files(previous_directory)
  current_files = revision_files(directory)
  modified = (current_files & previous_files).reject do |f|
    File.read(File.join(previous_directory, f)) == File.read(File.join(directory, f))
  end
  removed = previous_files - current_files
  added = current_files - previous_files
  renamed = renames(removed, added)
  {
    modified: modified,
    renamed: renamed,
    added: added - renamed.map(&:last),
    removed: removed - renamed.map(&:first),
  }
end

def file_items(changes)
  changes[:modified].map{|f| "~ #{f}"} +
    changes[:renamed].map{|from, to| "~ #{from} --> #{to}"} +
    changes[:added].map{|f| "+ #{f}"} +
    changes[:removed].map{|f| "- #{f}"}
end

# The whole of the diff, as `~ test/test.rb, test/6.0.csv --> test/6.1.csv`, three
# named and the rest counted as holdings_summary() does.
def snapshot_summary(changes)
  groups = [
    ['~', changes[:modified] + changes[:renamed].map{|from, to| "#{from} --> #{to}"}],
    ['+', changes[:added]],
    ['-', changes[:removed]],
  ]
  total = groups.sum{|marker, paths| paths.length}
  return 'Unchanged from the revision before.' if total == 0
  shown = 0
  parts = groups.filter_map do |marker, paths|
    named = paths.first([3 - shown, 0].max)
    shown += named.length
    "#{marker} #{named.join(', ')}" unless named.empty?
  end
  summary = parts.join('; ')
  total > shown ? "#{summary} and #{total - shown} more" : summary
end

# No version is stated, a commit titled with a version being a version.
def process_snapshot(directory, previous_directory, date, unparsed)
  binary = find_binary(directory)
  changes = file_changes(previous_directory, directory)
  items = within(binary, directory, structural_diff_of(previous_directory, directory))
  items += file_items(changes)
  format_entry(nil, date, directory, items + unparsed, snapshot_summary(changes))
end

# What diff_binaries() says of the header file, less the line count it falls back
# upon, which a snapshot's file items already cover by naming the file.
def structural_diff_of(previous_directory, directory)
  items = diff_binaries(previous_directory, directory)
  items.reject{|item| item =~ /\A~ \S+ \((?:[+-]\d+ lines(?:, )?)+\)\z/}
end

def process_subsequent_version(directory, index, previous_directory)
  binary = find_binary(directory)
  comments = read_header_comments(binary)
  version = parse_version(comments)
  date = parse_date(comments)
  changes = parse_changes(comments)
  # Before changes_are_new?, which parses the previous version and would leave
  # @unparsed_lines holding its lines rather than this one's.
  unparsed = unparsed_items(directory, changes ? changes[:unparsed] : @unparsed_lines)
  if snapshot?(directory, previous_directory, version, changes)
    return process_snapshot(directory, previous_directory, date, unparsed)
  end
  if changes && changes_are_new?(changes, previous_directory)
    items = changes[:items]
    summary = changes[:summary]
  else
    items = within(binary, directory, diff_binaries(previous_directory, directory))
    items += diff_other_files(previous_directory, directory)
    summary = nil
  end
  format_entry(version, date, directory, items + unparsed, summary)
end

# Taken from git-import-all 0.16.0, which no longer reads a CHANGELOG, and given
# each entry's whole text as well as its summary: an entry's body is a commit's
# message, and a message wants its items.
module Changelog
  ITEM = /\A\d+\.\s+(.*)\z/
  VERSION = /\[?v?(\d+(?:\.\d+)+)\]?/
  DATE = /(\d{4}-?\d{2}-?\d{2})/

  class NotUnderstood < RuntimeError; end

  module Format
    module Common
      def heading(text)
        text.lines.first.to_s.strip
      end

      def body_lines(text)
        text.lines.drop(1).map(&:strip)
      end

      # As written, less trailing space, so that an item's indentation is kept.
      def raw_body_lines(text)
        text.lines.drop(1).map(&:rstrip)
      end

      def items(text)
        body_lines(text).map{|line| line[Changelog::ITEM, 1]}.compact
      end

      def entry(version, date, summary, text, body)
        {version: version, date: date, summary: summary || items(text).first || 'No summary', body: body}
      end
    end

    module DatedHeading
      extend Common

      # changelogger writes ???????? where it has no date to give, and reads it back.
      BOUNDARY = /^##\s+(?:\d{8}|\?{8})\s*$/
      HEADING = /\A##\s+(\d{8}|\?{8})\s*\z/
      VERSIONED_SUMMARY = /\A(\d+(?:\.\d+)+)(?::\s*(.*))?\z/

      class << self
        def key
          :dated_heading
        end

        def matches?(text)
          !(heading(text) =~ HEADING).nil?
        end

        # A heading may stand over more than one version, changelogger writing one
        # heading per date as of 0.10.0 rather than one per version.  Each versioned
        # summary beneath a heading begins an entry and they share its date; a
        # heading with one version beneath it is a run of one.
        def parse(text)
          date = heading(text)[HEADING, 1]
          found = blocks(text)
          return [unversioned_entry(text, date)] if found.empty?
          found.collect{|block| entry(block[:version], date, block[:summary], block[:text], block[:text].rstrip)}
        end

        private

        # Each block's text begins with its own summary line, so that the items
        # beneath it are what entry() reads where no summary was stated.
        # A version line need not carry a summary: changelogger writes it bare where
        # the revision it read had no marker to take one from.  Bare, the entry takes
        # its first item instead, which is what entry() does with a nil summary.
        #
        # An entry begins at a line stating a version, and also after the two blank
        # lines changelogger writes between one entry and the next, so that an entry
        # stating no version, a snapshot's, is an entry of its own rather than part
        # of the one above it.
        def blocks(text)
          separated = true
          blanks = 0
          raw_body_lines(text).each_with_object([]) do |raw, blocks|
            line = raw.strip
            if line.empty?
              blanks += 1
              separated = true if blanks > 1
              blocks.last[:text] += "\n" unless blocks.empty?
              next
            end
            if line =~ VERSIONED_SUMMARY
              summary = $2.to_s.strip
              blocks << {version: $1, summary: (summary.empty? ? nil : summary), text: "#{line}\n"}
            elsif separated
              # An entry whose first line is itself an item takes that item as its
              # summary, stated here rather than left to entry(): items() reads a
              # text's lines after its first, that first being a summary line, and
              # would pass over the very item this block begins at.
              summary = line =~ Changelog::ITEM ? $1 : line
              blocks << {version: nil, summary: summary, text: "#{line}\n"}
            else
              blocks.last[:text] += "#{raw}\n"
            end
            blanks = 0
            separated = false
          end
        end

        def unversioned_entry(text, date)
          summary = body_lines(text).detect do |line|
            !line.empty? && !(line =~ Changelog::ITEM) && !line.start_with?('#')
          end
          entry(nil, date, summary, text, '')
        end
      end
    end

    module VersionedHeading
      extend Common

      BOUNDARY = /^##\s+\[?v?\d+(?:\.\d+)+/

      # A line is no summary where it is a heading of its own or a numbered item.
      NOT_PROSE = /\A(?:#|\d+\.\s)/

      class << self
        def key
          :versioned_heading
        end

        def matches?(text)
          line = heading(text)
          line.start_with?('##') && !line[Changelog::VERSION, 1].nil?
        end

        # The body is the entry as changelogger writes one, the heading's version
        # and summary for its first line and what the heading stood over beneath.
        # A summary taken from beneath the heading is moved up rather than repeated.
        def parse(text)
          line = heading(text).sub(/\A##\s+/, '')
          version = line[Changelog::VERSION, 1]
          date = line[Changelog::DATE, 1]
          summary = summary(line, version, date)
          lines = trimmed(raw_body_lines(text))
          if !summary && summary_line?(lines)
            summary = lines.first.strip
            lines = trimmed(lines.drop(1))
          end
          [entry(version, date, summary, text, body([version, summary].compact.join(': '), lines))]
        end

        private

        def summary(line, version, date)
          result = line.dup
          result.sub!(/\[?v?#{Regexp.escape(version)}\]?/, '') if version
          result.sub!(/\(?#{Regexp.escape(date)}\)?/, '') if date
          result.sub!(/\A[\s\-—\/(),:]+/, '')
          result.strip.empty? ? nil : result.strip
        end

        # The first line beneath the heading is a summary where it stands alone and
        # is prose, as a commit's subject does.  A list's first bullet is not alone.
        def summary_line?(lines)
          return false if lines.empty? || lines.first =~ NOT_PROSE
          lines.length == 1 || lines[1].empty?
        end

        def body(subject, lines)
          lines.empty? ? subject : "#{subject}\n\n#{lines.join("\n")}"
        end

        def trimmed(lines)
          lines.drop_while(&:empty?).reverse.drop_while(&:empty?).reverse
        end
      end
    end

    class << self
      def all
        [DatedHeading, VersionedHeading]
      end

      def boundary
        @boundary ||= Regexp.new("(?=#{all.map{|format| format::BOUNDARY.source}.join('|')})")
      end

      def for(text)
        matched = all.select{|format| format.matches?(text)}
        line = text.lines.first.to_s.strip
        raise NotUnderstood, "no CHANGELOG format matches: #{line}" if matched.empty?
        raise NotUnderstood, "ambiguous CHANGELOG format (#{matched.map(&:key).join(', ')}): #{line}" if matched.length > 1
        matched.first
      end
    end
  end

  class << self
    def parse(text)
      return [] unless text
      # Flattened in the order the file states them, newest first, and reversed
      # once at the end: a heading standing over several versions holds them in
      # that same order, so reversing the chunks alone left those in the wrong one.
      chunks(text).flat_map{|chunk| Format.for(chunk).parse(chunk)}.reverse
    end

    private

    def chunks(text)
      result = text.split(Format.boundary).reject{|chunk| chunk.strip.empty?}
      result.shift unless result.empty? || matched?(result.first)
      raise NotUnderstood, 'no CHANGELOG entries recognised' if result.empty?
      result
    end

    def matched?(chunk)
      Format.all.any?{|format| format.matches?(chunk)}
    end
  end
end

# A date as changelogger writes one, YYYYMMDD, whichever way the heading wrote it.
def changelog_date(date)
  date ? date.delete('-') : MISSING_DATE
end

# The entries a CHANGELOG already holds, oldest first as write_changelog wants
# them, in changelogger's own form or in one with a version in each heading.  One
# not understood gives none, and says so, rather than ending the run.
def entries_from(directory)
  entries = Changelog.parse(File.read(changelog_path(directory))).collect do |entry|
    {date: changelog_date(entry[:date]), body: entry[:body]}
  end
  $stderr.puts "#{File.basename(directory)}: took #{entries.length} entries from its CHANGELOG"
  entries
rescue Changelog::NotUnderstood => e
  $stderr.puts "#{File.basename(directory)}: #{e.message}; took no entries from its CHANGELOG"
  []
end

def revisions_path
  File.join(revisions_root, 'revisions.yml')
end

def day(date)
  "#{date[0, 4]}-#{date[4, 2]}-#{date[6, 2]}"
end

def revisions(entries)
  version_directories.zip(entries).collect do |directory, entry|
    {'revision' => File.basename(directory).to_i, 'time' => day(entry[:date]), 'message' => entry[:body]}
  end
end

# Each message is a literal block, its lines as they are and nothing escaped,
# which is how one is read and edited by hand.  The emitter quotes one instead
# where a block cannot hold it.
def revisions_yaml(entries)
  tree = Psych::Visitors::YAMLTree.create
  tree << {'revisions' => revisions(entries)}
  stream = tree.tree
  stream.grep(Psych::Nodes::Mapping).each do |mapping|
    mapping.children.each_slice(2){|key, value| value.style = Psych::Nodes::Scalar::LITERAL if key.value == 'message'}
  end
  stream.children.first.implicit = true
  stream.to_yaml
end

# Plan

# Every revision's entry, oldest first, by the tiers from its header.  A revision
# already holding a CHANGELOG, written by hand, gives what that holds in place of
# every entry up to it, rather than nothing: a revision which contributed none
# left every revision after it short by an entry apiece.
def planned_entries
  entries = []
  previous_directory = nil
  version_directories.each_with_index do |directory, index|
    if changelog_exist?(directory)
      entries = entries_from(directory)
    elsif index == 0
      entries << process_initial_version(directory)
    else
      entries << process_subsequent_version(directory, index, previous_directory)
    end
    previous_directory = directory
  end
  entries
end

# What git-import-all wants before it takes the file, said rather than refused,
# revisions.yml being where it is given.
def note_gaps(entries)
  version_directories.zip(entries).each do |directory, entry|
    name = File.basename(directory)
    $stderr.puts "#{name}: no date; give it a time in revisions.yml" unless real_date?(entry[:date])
    $stderr.puts "#{name}: no message; give it one in revisions.yml" if entry[:body].strip.empty?
  end
end

# Once written, revisions.yml is the record, and is corrected where it stands
# rather than planned again.
def plan
  abort "revisions.yml already exists, and is not replaced: it is the record now" if File.exist?(revisions_path)
  entries = planned_entries
  unless entries.length == version_directories.length
    abort "Wrote no revisions.yml: #{entries.length} entries for #{version_directories.length} revisions"
  end
  File.write(revisions_path, revisions_yaml(entries))
  puts "Wrote revisions.yml"
  note_gaps(entries)
end

# Build

REVISION_DAY = /\A\d{4}-\d{2}-\d{2}\z/
REVISION_TIME = /\A\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2} [+-]\d{4}\z/

# The day a time falls upon in the zone it states, as YYYYMMDD, or nil where
# git-import-all could not read it, it taking a bare day or a full time, quoted.
def day_of(time)
  return nil unless time.is_a?(String)
  if time =~ REVISION_DAY
    Date.strptime(time, '%Y-%m-%d').strftime('%Y%m%d')
  elsif time =~ REVISION_TIME
    DateTime.strptime(time, '%Y-%m-%d %H:%M:%S %z').strftime('%Y%m%d')
  end
rescue Date::Error
  nil
end

def recorded_list
  abort "No revisions.yml: run changelogger plan first" unless File.exist?(revisions_path)
  data = YAML.safe_load(File.read(revisions_path), permitted_classes: [Date, Time])
  list = data['revisions'] if data.is_a?(Hash)
  abort "revisions.yml has no revisions list" unless list.is_a?(Array)
  list
rescue Psych::Exception => e
  abort "revisions.yml does not parse: #{e.message}"
end

def entry_faults(entry, index, number)
  return ["revisions[#{index}] is not a mapping"] unless entry.is_a?(Hash)
  faults = []
  faults << "revisions[#{index}] states revision #{entry['revision'].inspect} where the directory at its place is #{number}" unless entry['revision'] == number
  faults << "revisions[#{index}] has a time which does not parse: #{entry['time'].inspect}" unless day_of(entry['time'])
  faults << "revisions[#{index}] has no message" unless entry['message'].is_a?(String) && !entry['message'].strip.empty?
  faults
end

# Whatever git-import-all would refuse the file for, it taking each entry for the
# directory at the same place.
def recorded_faults(list)
  faults = list.first(version_directories.length).each_with_index.flat_map do |entry, index|
    entry_faults(entry, index, File.basename(version_directories[index]).to_i)
  end
  faults << "#{list.length} entries for #{version_directories.length} revisions" unless list.length == version_directories.length
  faults
end

# Nothing is written from a file git-import-all would refuse, so that the
# CHANGELOGs and the commits are made from the same record.
def recorded_entries
  list = recorded_list
  faults = recorded_faults(list)
  abort faults.map{|fault| "revisions.yml: #{fault}"}.join("\n") unless faults.empty?
  list.collect{|entry| {date: day_of(entry['time']), body: entry['message'].rstrip}}
end

def build
  entries = recorded_entries
  version_directories.each_with_index{|directory, index| write_changelog(directory, entries.first(index + 1))}
end

def main
  validate_command
  parse_arguments
  send(command)
end

main
